# Google Cloud AI / Gemini API Key (Required)
# Obtain from https://aistudio.google.com/apikey or GCP Vertex AI
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here

# Parallel Web API Key (Optional)
# The Search MCP at https://search-mcp.parallel.ai/mcp is zero-auth by default.
# Adding a key from https://platform.parallel.ai unlocks higher rate limits.
PARALLEL_API_KEY=your_parallel_api_key_here

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
